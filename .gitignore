# Секретные переменные Terraform
*.tfvars

# Локальные стейт-файлы Terraform
*.tfstate
*.tfstate.*

# Директория с плагинами провайдеров
.terraform/
.terraform.lock.hcl

# Чувствительные данные Ansible
*.retry

# Автогенерируемый инвентарь Ansible
inventory.ini

# Пароль для Ansible Vault
.vault_pass
